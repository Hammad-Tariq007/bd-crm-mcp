# Copy to .env (or set these in your MCP client config) and fill in.

# Base URL of the CRM (no trailing slash). e.g. https://bd-crm.meissasoft.com
CRM_BASE_URL=https://bd-crm.meissasoft.com

# Personal Access Token minted in the CRM (Profile → Settings → API tokens / Personal access tokens).
# The token's user must be a workspace admin AND (the workspace owner OR granted analytics access).
CRM_API_TOKEN=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Workspace slug (from the CRM URL: /<workspace-slug>/projects/...)
WORKSPACE_SLUG=bd-leads

# The BD Leads project id (UUID). Open the project; it's in the URL: /projects/<PROJECT_ID>/
PROJECT_ID=00000000-0000-0000-0000-000000000000
