# Copy to .env (or set these in your MCP client config) and fill in.

# Base URL of the CRM (no trailing slash). e.g. https://bd-crm.meissasoft.com
CRM_BASE_URL=https://bd-crm.meissasoft.com

# Personal Access Token minted in the CRM (Profile → Settings → API tokens / Personal access tokens).
# The token's user must be a workspace admin AND (the workspace owner OR granted analytics access).
CRM_API_TOKEN=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Workspace slug (from the CRM URL: /<workspace-slug>/projects/...)
WORKSPACE_SLUG=bd-leads

# The BD Leads project id (UUID). Open the project; it's in the URL: /projects/<PROJECT_ID>/
PROJECT_ID=00000000-0000-0000-0000-000000000000


# ============================================================================
# HOSTED SERVICE ONLY (server/ — web chat UI + remote MCP endpoint).
# The stdio server above does NOT use any of the variables below.
# These are all read from the environment; never commit real values.
# ============================================================================

# Owner-level token used for ALL data fetching. Never sent to the browser.
# Must belong to a user who passes the analytics gate (workspace admin + owner/flag).
CRM_ADMIN_TOKEN=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM backend for the chat UI — any OpenAI-compatible chat/completions provider (OpenRouter).
# Server-side only. Leave LLM_API_KEY blank to disable chat.
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5

# Secret used to sign the httpOnly session cookie. Generate a random 32+ byte value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the hosted service listens on (Caddy reverse-proxies /mcp/* here).
PORT=8787

# Set to "production" in prod so session cookies get the Secure flag (TLS-only).
# NODE_ENV=production
