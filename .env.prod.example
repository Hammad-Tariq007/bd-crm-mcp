# ============================================================================
# PROD env for the hosted service (server/).
# Copy to `.env` next to docker-compose and fill the 3 secrets:
#   cp .env.prod.example .env
# Never commit real secret values.
# ============================================================================

# --- environment-specific (prod) ---
CRM_BASE_URL=https://bd-crm.meissasoft.com
WORKSPACE_SLUG=bd-leads
PROJECT_ID=865c22fa-22f7-483b-b399-de15d1c06c1f

# --- cross-env (same in dev & prod; may be left blank to use app defaults) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-5

# --- runtime ---
PORT=8787
NODE_ENV=production
# Image tag to deploy (build & push to GHCR first). Omit to use :latest.
# MCP_IMAGE_TAG=v1.0.0

# --- secrets (PLACEHOLDERS ONLY — fill on the host, never commit) ---
# Owner-level CRM token used for ALL data fetching. Never sent to the browser.
CRM_ADMIN_TOKEN=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenRouter (or any OpenAI-compatible) key for the chat backend. Server-side only.
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HMAC key for the session cookie. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
